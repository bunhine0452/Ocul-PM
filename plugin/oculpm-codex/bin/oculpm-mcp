#!/bin/sh
# oculpm-mcp 셔틀 (#a1-schema-paths) — 설치 위치가 유동적인 실바이너리를 찾아
# exec 한다. 종전 .mcp.json 은 macOS 절대경로를 하드코딩해 앱을 다른 위치에
# 설치하면 즉시 깨졌다. 탐색 순서 (앱의 `acp/recording.rs` `candidate_paths` 와
# 같은 자리·같은 순서 — 화면의 안내와 셔틀이 다른 곳을 가리키지 않게):
#   1. OCULPM_MCP_BIN 환경변수 (수동 지정)
#   2. macOS .app 번들 (시스템 / 유저 Applications)
#   3. Linux — deb(/usr/bin), AppImage 안정 사본. AppImage 안의 원본은 실행 중에만
#      있는 마운트라 가리킬 수 없어, 앱이 기동 때
#      ${XDG_DATA_HOME:-~/.local/share}/ocul-pm/bin 으로 복사한다.
#   4. ~/.local/bin (수동 설치 — macOS·Linux)
#   5. Windows (훅이 Git Bash 로 이 셔틀을 돌린다) — NSIS 사용자 설치
#      %LOCALAPPDATA%\Ocul-PM (다중 사용자 모드는 %LOCALAPPDATA%\Programs\Ocul-PM),
#      시스템 설치 %ProgramFiles%\Ocul-PM (32비트 셸이면 %ProgramW6432% 가 그 자리)
#   6. 리포 개발 빌드 — `claude --plugin-dir <리포>/plugin/oculpm` 로 리포에서
#      직접 로드할 때만 존재한다 (마켓플레이스 설치본에는 없는 경로).
# 없는 환경변수는 빈 후보가 되어 건너뛴다 (set -u 아래라 :- / :+ 로만 연다).
# Git Bash 는 Windows 변수 이름의 대소문자를 그대로 두기도, 대문자로 바꾸기도
# 해서 두 표기를 다 본다.
# stdout 은 MCP 프로토콜 전용 — 안내는 전부 stderr 로.
set -u
plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
data_home=${XDG_DATA_HOME:-${HOME:+$HOME/.local/share}}
program_files=${PROGRAMFILES:-${ProgramFiles:-}}
program_w6432=${PROGRAMW6432:-${ProgramW6432:-}}
for cand in \
  "${OCULPM_MCP_BIN:-}" \
  "/Applications/ocul-pm.app/Contents/MacOS/oculpm-mcp" \
  "$HOME/Applications/ocul-pm.app/Contents/MacOS/oculpm-mcp" \
  "/usr/bin/oculpm-mcp" \
  "${data_home:+$data_home/ocul-pm/bin/oculpm-mcp}" \
  "$HOME/.local/bin/oculpm-mcp" \
  "${LOCALAPPDATA:+$LOCALAPPDATA/Ocul-PM/oculpm-mcp.exe}" \
  "${LOCALAPPDATA:+$LOCALAPPDATA/Programs/Ocul-PM/oculpm-mcp.exe}" \
  "${program_files:+$program_files/Ocul-PM/oculpm-mcp.exe}" \
  "${program_w6432:+$program_w6432/Ocul-PM/oculpm-mcp.exe}" \
  "$plugin_root/../../src-tauri/target/debug/oculpm-mcp" \
  "$plugin_root/../../src-tauri/target/release/oculpm-mcp"
do
  if [ -n "$cand" ] && [ -x "$cand" ]; then
    exec "$cand" "$@"
  fi
done
echo "oculpm-mcp: 실행 파일을 찾지 못했습니다 — ocul-pm 앱을 설치하거나 (https://oculpm.com)" >&2
echo "OCULPM_MCP_BIN 환경변수로 바이너리 경로를 지정하세요. (macOS · Linux · Windows 지원 — Windows 는 Git Bash 가 이 셔틀을 돌린다)" >&2
exit 1
