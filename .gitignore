# ---------- Node / pnpm ----------
node_modules
.pnpm-store

# ---------- Build output ----------
dist
dist-ssr
build
*.local

# ---------- Tauri / Rust ----------
# (src-tauri/.gitignore also covers target/ and gen/schemas)
src-tauri/target
src-tauri/gen/schemas

# Embedding model cache (fastembed downloads ~120MB ONNX models here).
# Lives wherever the binary is run from, so match anywhere.
**/.fastembed_cache/
**/.cache/fastembed*/

# ---------- Generated bindings ----------
# tauri-specta regenerates src/lib/bindings.ts during the Rust build, but it is
# COMMITTED so the CI frontend build (tsc) — which runs before cargo — has it.

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Logs ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Local DB / runtime data (in case anything is copied into repo) ----------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- Tauri updater signing key (NEVER commit — goes in a GH secret) ----------
src-tauri/updater.key

# ---------- Environment files (we use OS keychain, but be safe) ----------
.env
.env.*
!.env.example

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Claude Code workspace ----------
.claude/

# oculpm:begin v1
.oculpm/index/
.oculpm/hooks/
.oculpm/.lock
.oculpm/.schema-version
.oculpm/oculpm.log
.oculpm.backup-*/
# oculpm:end
