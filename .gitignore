# ---------- Node / pnpm ----------
node_modules
.pnpm-store

# ---------- Build output ----------
dist
dist-ssr
build
*.local

# ---------- Tauri / Rust ----------
# (src-tauri/.gitignore also covers target/ and gen/schemas)
src-tauri/target
src-tauri/gen/schemas
# build-sidecar.mjs staging dir (externalBin) — 빌드 산출물, 커밋 금지
src-tauri/binaries/

# Embedding model cache (fastembed downloads ~120MB ONNX models here).
# Lives wherever the binary is run from, so match anywhere.
**/.fastembed_cache/
**/.cache/fastembed*/

# ---------- Generated bindings ----------
# tauri-specta regenerates src/lib/bindings.ts during the Rust build, but it is
# COMMITTED so the CI frontend build (tsc) — which runs before cargo — has it.

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Logs ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Local DB / runtime data (in case anything is copied into repo) ----------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- Tauri updater signing key (NEVER commit — goes in a GH secret) ----------
src-tauri/updater.key

# ---------- Environment files (we use OS keychain, but be safe) ----------
.env
.env.*
!.env.example

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Claude Code workspace ----------
.claude/
# PR-CI2: 앱이 써 주는 MCP 등록 파일. 서버 바이너리 경로가 이 머신 전용이라
# (dev 는 src-tauri/target/, 배포는 .app 내부) 공유하면 팀원에게 깨진 설정이
# 된다 — 각자 설정 → Agents → MCP 서버 "등록" 으로 생성. PR-CI8(플러그인
# 패키징)이 경로 문제를 해소하면 이 줄을 재검토한다.
# ⚠ 반드시 루트 앵커(`/`) — 앵커 없으면 모든 깊이에 매칭돼
# `plugin/oculpm/.mcp.json`(플러그인이 배포하는 번들 파일)까지 삼킨다.
/.mcp.json

# 훅 이벤트 인박스 — payload 에 로컬 경로·대화 흔적 포함, 커밋 금지.
# (관리블록이 구버전 앱에 의해 downgrade 되는 사고가 있어 블록 밖에 고정)
.oculpm/hooks/
# oculpm:begin v1
.oculpm/index/
.oculpm/hooks/
.oculpm/agents/live/
.oculpm/agents/audit/
.oculpm/.lock
.oculpm/.schema-version
.oculpm/oculpm.log
.oculpm.backup-*/
# oculpm:end
.vercel

# 에이전틱 벤치마크 세션 원본 (benchmarks/agentic — 리포트 .md 만 커밋)
benchmarks/agentic/results/raw/
