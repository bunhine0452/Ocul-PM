{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ocul-PM",
  "version": "2.10.0",
  "identifier": "com.kimhyunbin.ocul-pm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ocul-PM",
        "hiddenTitle": true,
        "width": 1150,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/oculpm-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bunhine0452/Ocul-PM/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QzUzNUMyMEU5REJCNjEKUldSaHU1ME93alhGOUp0Wm9OZEMyRWNTcUxXNThHRGlnWDV2U3p1MngvVkxrcUkwZzR4S1lldGwK"
    }
  }
}