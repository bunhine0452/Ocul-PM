{
  "app": {
    "windows": [
      {
        "title": "Ocul",
        "width": 1150,
        "height": 780,
        "minWidth": 480,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#f1eee6"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
