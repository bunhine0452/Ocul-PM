{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the launcher window + project windows",
  "windows": ["main", "win-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "dialog:default",
    "dialog:allow-save",
    "updater:default",
    "process:default",
    "notification:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom"
  ]
}
