{
  "name": "ocul",
  "displayName": "Ocul — receipts for coding agents",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "oculpm",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunhine0452/Ocul-PM.git",
    "directory": "extension"
  },
  "homepage": "https://oculpm.com",
  "bugs": "https://github.com/bunhine0452/Ocul-PM/issues",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "claude code",
    "codex",
    "ai agent",
    "journal",
    "pull request",
    "receipt"
  ],
  "activationEvents": [
    "workspaceContains:.oculpm"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "ocul.showPanel",
        "title": "%cmd.showPanel%",
        "category": "Ocul",
        "icon": "$(eye)"
      },
      {
        "command": "ocul.fileHistory",
        "title": "%cmd.fileHistory%",
        "category": "Ocul",
        "icon": "$(history)"
      },
      {
        "command": "ocul.copyReceipt",
        "title": "%cmd.copyReceipt%",
        "category": "Ocul",
        "icon": "$(copy)"
      },
      {
        "command": "ocul.refresh",
        "title": "%cmd.refresh%",
        "category": "Ocul",
        "icon": "$(refresh)"
      },
      {
        "command": "ocul.openInApp",
        "title": "%cmd.openInApp%",
        "category": "Ocul",
        "icon": "$(link-external)"
      },
      {
        "command": "ocul.continueInTerminal",
        "title": "%cmd.continueInTerminal%",
        "category": "Ocul",
        "icon": "$(terminal)"
      },
      {
        "command": "ocul.panel.openInApp",
        "title": "%cmd.openInApp%",
        "icon": "$(link-external)"
      },
      {
        "command": "ocul.panel.continue",
        "title": "%cmd.continueInTerminal%",
        "icon": "$(play)"
      },
      {
        "command": "ocul.panel.openToday",
        "title": "%cmd.openToday%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ocul.fileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "7_ocul"
        },
        {
          "command": "ocul.openInApp",
          "when": "!explorerResourceIsFolder",
          "group": "7_ocul"
        }
      ],
      "editor/title/context": [
        {
          "command": "ocul.fileHistory",
          "group": "7_ocul"
        },
        {
          "command": "ocul.openInApp",
          "group": "7_ocul"
        }
      ],
      "scm/title": [
        {
          "command": "ocul.copyReceipt",
          "group": "inline@99"
        }
      ],
      "view/title": [
        {
          "command": "ocul.openInApp",
          "when": "view == ocul.overview",
          "group": "navigation@1"
        },
        {
          "command": "ocul.copyReceipt",
          "when": "view == ocul.overview",
          "group": "navigation@2"
        },
        {
          "command": "ocul.refresh",
          "when": "view == ocul.overview",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ocul.panel.continue",
          "when": "view == ocul.overview && viewItem == next",
          "group": "inline@1"
        },
        {
          "command": "ocul.panel.openInApp",
          "when": "view == ocul.overview && viewItem =~ /^(next|plan|journal|claude)$/",
          "group": "inline@2"
        },
        {
          "command": "ocul.panel.continue",
          "when": "view == ocul.overview && viewItem == next",
          "group": "1_ocul@1"
        },
        {
          "command": "ocul.panel.openInApp",
          "when": "view == ocul.overview && viewItem =~ /^(next|plan|journal|claude)$/",
          "group": "1_ocul@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ocul.panel.openInApp",
          "when": "false"
        },
        {
          "command": "ocul.panel.continue",
          "when": "false"
        },
        {
          "command": "ocul.panel.openToday",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Ocul",
      "properties": {
        "ocul.explorerBadges": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.explorerBadges%"
        },
        "ocul.notifyWhenClaudeWaits": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifyWhenClaudeWaits%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ocul",
          "title": "Ocul",
          "icon": "media/ocul.svg"
        }
      ]
    },
    "views": {
      "ocul": [
        {
          "id": "ocul.overview",
          "name": "%view.overview%",
          "when": "ocul.tracked",
          "icon": "media/ocul.svg",
          "contextualTitle": "Ocul"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && node esbuild.mjs",
    "package": "pnpm run check-types && node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
